<Window x:Class="NetSentry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:NetSentry.App.Views"
        mc:Ignorable="d"
        Title="NetSentry — Network Defense &amp; Discovery"
        Height="840" Width="1280"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindowBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════
             TOP BAR: BRANDING, HISTORY NAV & SCAN TRIGGER
             ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgWindowBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="18,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Logo + History Nav -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- NetSentry Shield Icon -->
                    <Border Width="30" Height="30" CornerRadius="6" Background="#172554" BorderBrush="#2563EB" BorderThickness="1" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconShield}" Fill="#38BDF8" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="NETSENTRY" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="NETWORK GUARD" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" />
                    </StackPanel>

                    <!-- History navigation buttons -->
                    <Border Width="1" Height="20" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />

                    <Button x:Name="BackNavBtn" Style="{StaticResource TopNavButtonStyle}"
                            Width="32" Height="30" Margin="0,0,6,0" Click="BackNavBtn_Click" IsEnabled="False"
                            ToolTip="Go back">
                        <Path Data="{StaticResource IconBack}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="12" Height="12" Stretch="Uniform" />
                    </Button>

                    <Button x:Name="FwdNavBtn" Style="{StaticResource TopNavButtonStyle}"
                            Width="32" Height="30" Click="FwdNavBtn_Click" IsEnabled="False"
                            ToolTip="Go forward">
                        <Path Data="{StaticResource IconBack}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="12" Height="12" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                </StackPanel>

                <!-- Top Right: Scan Network Button -->
                <Button Grid.Column="2" x:Name="TopScanBtn"
                        Style="{StaticResource ScanNetworkButtonStyle}" Click="TopScanBtn_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefresh}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Scan Network" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════
             BODY: SIDEBAR + MAIN CONTENT WORKSPACE
             ══════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── LEFT SIDEBAR ── -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0"
                    Padding="14,18,14,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Active Network Context Card -->
                    <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="ACTIVE NETWORK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="SidebarNetName" Text="Local Network" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                            <TextBlock x:Name="SidebarWorkspace" Text="Subnet: Detecting..." FontSize="11"
                                       Foreground="{StaticResource AccentCyanBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- Navigation Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,2,0,0">
                            <!-- Overview Tab -->
                            <RadioButton x:Name="NavOverviewBtn" GroupName="Nav"
                                         IsChecked="True" Style="{StaticResource SidebarButtonStyle}"
                                         Click="Nav_Overview_Click" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconDashboard}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Overview" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Devices Tab -->
                            <Grid Margin="0,0,0,6">
                                <RadioButton x:Name="NavDevicesBtn" GroupName="Nav"
                                             Style="{StaticResource SidebarButtonStyle}"
                                             Click="Nav_Devices_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDevices}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Devices" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- Device Count Badge -->
                                <Border x:Name="DevicesCountBadge" Background="#172554" BorderBrush="#1E40AF" BorderThickness="1"
                                        CornerRadius="10" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,10,0" IsHitTestVisible="False">
                                    <TextBlock x:Name="SidebarDevicesCount" Text="0" FontSize="11" FontWeight="Bold"
                                               Foreground="#38BDF8" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Engine Status Card -->
                    <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,8,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="7" Height="7" CornerRadius="3.5" Background="#10B981" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="SECURITY ENGINE" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                            </StackPanel>
                            <TextBlock Text="ARP Spoof Isolation" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Hardware protection active" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Network Guard Status -->
                    <Border Grid.Row="3" Background="#0C1322" BorderBrush="#172238" BorderThickness="1"
                            CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="SUBNET ENFORCEMENT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="Foreign host isolation on" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── MAIN CONTENT VIEWPORTS ── -->
            <Grid Grid.Column="1">
                <views:OverviewView x:Name="OverviewControl" Visibility="Visible" />
                <views:DeviceListView x:Name="DeviceListControl" Visibility="Collapsed" />
                <views:DeviceDetailView x:Name="DeviceDetailControl" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>

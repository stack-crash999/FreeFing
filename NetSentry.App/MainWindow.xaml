<Window x:Class="NetSentry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:NetSentry.App.Models"
        mc:Ignorable="d"
        Title="NetGuardian Desktop"
        Width="1280" Height="820"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#0E131F"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid Background="#0E131F">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════
             LEFT NAVIGATION RAIL
             ══════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#121824" BorderBrush="#1C2436" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <!-- Top Primary Brand Glyph -->
                <TextBlock DockPanel.Dock="Top" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" 
                           Foreground="#2563EB" FontSize="20" HorizontalAlignment="Center" Margin="0,18,0,24"/>

                <!-- Nav Buttons (Dashboard, Devices, Security) -->
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Button Style="{StaticResource NavIconButtonStyle}" Content="&#xE80F;" ToolTip="Dashboard" Click="NavDashboard_Click" Margin="0,0,0,12"/>
                    <Button Style="{StaticResource NavIconButtonStyle}" Content="&#xECC9;" ToolTip="Device Map" Click="NavDeviceMap_Click" Margin="0,0,0,12"/>
                    <Button Style="{StaticResource NavIconButtonStyle}" Content="&#xEBE8;" ToolTip="Security" Click="NavSecurity_Click" Margin="0,0,0,12"/>
                </StackPanel>

                <!-- Settings Button -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavIconButtonStyle}" Content="&#xE713;" ToolTip="Settings" Click="NavSettings_Click" Margin="0,0,0,18"/>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════
             MAIN CONTENT CANVAS
             ══════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Top Header & Actions ── -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Network Overview" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="SubnetSubtitleBlock" Text="Connected to Home Subnet • 192.168.1.0/24" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="ScanBtn" Content="Scan Network" 
                        Style="{StaticResource ScanButtonStyle}"
                        Click="ScanBtn_Click"/>
            </Grid>

            <!-- ── Summary HUD Glass Cards ── -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: TOTAL DEVICES -->
                <Border Grid.Column="0" Background="#182030" BorderBrush="#232E45" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="TOTAL DEVICES" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TotalDevicesBlock" Text="0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: ONLINE STATUS -->
                <Border Grid.Column="2" Background="#182030" BorderBrush="#232E45" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="ONLINE STATUS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="OnlineStatusBlock" Text="0 Active" FontSize="28" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: BLOCKED -->
                <Border Grid.Column="4" Background="#182030" BorderBrush="#232E45" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="BLOCKED" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="BlockedStatusBlock" Text="0 Devices" FontSize="28" FontWeight="Bold" Foreground="#F43F5E" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: SECURITY HEALTH -->
                <Border Grid.Column="6" Background="#182030" BorderBrush="#232E45" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="SECURITY HEALTH" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="SecurityHealthBlock" Text="Optimal" FontSize="28" FontWeight="Bold" Foreground="#3B82F6" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Device Fleet List View ── -->
            <Border Grid.Row="2" Background="#182030" BorderBrush="#232E45" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <ListView x:Name="DevicesListView" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#1C2538"/>
                            <Setter Property="Padding" Value="16,12"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="rowBorder" Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="rowBorder" Property="Background" Value="#1D273B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DeviceItem}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <!-- Device Icon Badge -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Name & Network Identity -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Vendor Tag -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Status Badge -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Action Button -->
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Device Icon Badge -->
                                <Border Grid.Column="0" Background="#121824" Width="42" Height="42" CornerRadius="10" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" Foreground="#94A3B8" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Name & Network Identity -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IpAddress}" FontSize="12" Foreground="#94A3B8" FontFamily="Consolas, Cascadia Code"/>
                                        <TextBlock Text=" • " Foreground="#64748B"/>
                                        <TextBlock Text="{Binding MacAddress}" FontSize="12" Foreground="#64748B" FontFamily="Consolas, Cascadia Code"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Vendor Tag -->
                                <Border Grid.Column="2" Background="#121824" BorderBrush="#232E45" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Vendor}" FontSize="11" Foreground="#CBD5E1"/>
                                </Border>

                                <!-- Status Badge -->
                                <Border Grid.Column="3" Background="{Binding StatusBackgroundBrush}" CornerRadius="12" Padding="12,4" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusForegroundBrush}"/>
                                </Border>

                                <!-- Action Button -->
                                <Button Grid.Column="4" Content="{Binding ActionButtonText}" 
                                        Background="{Binding ActionBackgroundBrush}" 
                                        Foreground="{Binding ActionForegroundBrush}"
                                        Style="{StaticResource RowActionButtonStyle}"
                                        Click="ActionButton_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Window>

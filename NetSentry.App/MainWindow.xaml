<Window x:Class="NetSentry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:NetSentry.App.Views"
        mc:Ignorable="d"
        Title="FreeFing Desktop — Developed by SynETXSoftware"
        Width="1360" Height="880"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindowBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid Background="{DynamicResource BgWindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════
             LEFT NAVIGATION RAIL
             ══════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <!-- Top Primary Brand Glyph -->
                <TextBlock DockPanel.Dock="Top" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" 
                           Foreground="{DynamicResource AccentBlueBrush}" FontSize="22" HorizontalAlignment="Center" Margin="0,18,0,22"/>

                <!-- Navigation Tabs: Overview, Devices, Insights, Security, Setup -->
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <!-- Tab 1: Overview -->
                    <Button x:Name="NavOverviewBtn" Style="{StaticResource NavIconButtonStyle}" 
                            Content="&#xE80F;" ToolTip="Overview" Click="NavOverview_Click" Margin="0,0,0,10"/>

                    <!-- Tab 2: Devices (Computer Icon &#xE7F5;) -->
                    <Button x:Name="NavDevicesBtn" Style="{StaticResource NavIconButtonStyle}" 
                            Content="&#xE7F5;" ToolTip="Device Inventory" Click="NavDevices_Click" Margin="0,0,0,10"/>

                    <!-- Tab 3: Insights (Chart/Analytics Icon &#xE9D9;) -->
                    <Button x:Name="NavInsightsBtn" Style="{StaticResource NavIconButtonStyle}" 
                            Content="&#xE9D9;" ToolTip="Network Insights" Click="NavInsights_Click" Margin="0,0,0,10"/>

                    <!-- Tab 4: Security -->
                    <Button x:Name="NavSecurityBtn" Style="{StaticResource NavIconButtonStyle}" 
                            Content="&#xEBE8;" ToolTip="Security &amp; Defense" Click="NavSecurity_Click" Margin="0,0,0,10"/>

                    <!-- Tab 5: Setup -->
                    <Button x:Name="NavSetupBtn" Style="{StaticResource NavIconButtonStyle}" 
                            Content="&#xE713;" ToolTip="Setup &amp; Preferences" Click="NavSetup_Click" Margin="0,0,0,10"/>
                </StackPanel>

                <!-- Bottom Developer Branding: SynETXSoftware Logo & Monogram -->
                <Border DockPanel.Dock="Bottom" Margin="0,0,0,16" HorizontalAlignment="Center" ToolTip="Developed by SynETXSoftware">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- SynETX Logo Image & Monogram -->
                        <Border Width="40" Height="40" CornerRadius="10" Background="#182030" BorderBrush="#2563EB" BorderThickness="1.5">
                            <Image Source="pack://application:,,,/Assets/synetx_logo.jpg" Width="36" Height="36" Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,36,36"/>
                                </Image.Clip>
                            </Image>
                        </Border>
                        <TextBlock Text="SynETX" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════
             MAIN VIEWPORT CANVAS
             ══════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Global Top Application Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Page Content Viewport -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Global Top Application Bar ── -->
            <Border Grid.Row="0" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="28,12,28,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Breadcrumb & Network Status -->
                        <ColumnDefinition Width="*" />
                        <!-- Top Nav Tab Switcher -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Theme Toggle Button -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Quick Scan Action -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Network Title & Developer Brand Subtitle -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="FreeFing Desktop" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            
                            <!-- SynETXSoftware Official Badge -->
                            <Border Background="#1A2563EB" BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource LogoSynETX}" Fill="#38BDF8" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="by SynETXSoftware" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TopSubnetBlock" Text="Connected to Home Subnet • 192.168.1.0/24" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- Top Navigation Tabs (Overview, Devices, Insights, Security, Setup) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button x:Name="TopTabOverview" Content="Overview" Click="NavOverview_Click"
                                Style="{StaticResource TopNavButtonStyle}" Margin="0,0,5,0" Padding="13,6" />
                        <Button x:Name="TopTabDevices" Content="Devices" Click="NavDevices_Click"
                                Style="{StaticResource TopNavButtonStyle}" Margin="0,0,5,0" Padding="13,6" />
                        <Button x:Name="TopTabInsights" Content="Insights" Click="NavInsights_Click"
                                Style="{StaticResource TopNavButtonStyle}" Margin="0,0,5,0" Padding="13,6" />
                        <Button x:Name="TopTabSecurity" Content="Security" Click="NavSecurity_Click"
                                Style="{StaticResource TopNavButtonStyle}" Margin="0,0,5,0" Padding="13,6" />
                        <Button x:Name="TopTabSetup" Content="Setup" Click="NavSetup_Click"
                                Style="{StaticResource TopNavButtonStyle}" Padding="13,6" />
                    </StackPanel>

                    <!-- Dark / Light Mode Toggle Button -->
                    <Button Grid.Column="2" x:Name="ThemeToggleBtn" Click="ThemeToggleBtn_Click"
                            Style="{StaticResource TopNavButtonStyle}"
                            Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Toggle Dark / Light Mode">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="ThemeIconPath" Data="{StaticResource IconSun}" Fill="#F59E0B" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ThemeText" Text="Light Mode" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Scan Trigger Button -->
                    <Button Grid.Column="3" x:Name="GlobalScanBtn" Content="Scan Network" 
                            Style="{StaticResource ScanButtonStyle}"
                            Padding="18,7"
                            Click="GlobalScanBtn_Click"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Page Content Multi-View Container ── -->
            <Grid Grid.Row="1">
                <!-- Page 1: Overview View (Total Devices, Net Traffic Amount, Scan, ISP with dynamic logo) -->
                <views:OverviewView x:Name="OverviewControl" Visibility="Visible" />

                <!-- Page 2: Device List View (All devices with type, brand, status filtering, prominent model) -->
                <views:DeviceListView x:Name="DeviceListControl" Visibility="Collapsed" />

                <!-- Page 3: Device Detail View (Full device specifications, model identification, open ports, block) -->
                <views:DeviceDetailView x:Name="DeviceDetailControl" Visibility="Collapsed" />

                <!-- Page 4: Insights View (Device distribution, model recognition, smart home ecosystems, lifecycle) -->
                <views:InsightsView x:Name="InsightsControl" Visibility="Collapsed" />

                <!-- Page 5: Security View (Firewall status, isolated devices list with unblock controls) -->
                <views:SecurityView x:Name="SecurityControl" Visibility="Collapsed" />

                <!-- Page 6: Setup View (Network scanning, ARP blocking parameters, adapter bindings, database diagnostics) -->
                <views:SetupView x:Name="SetupControl" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>

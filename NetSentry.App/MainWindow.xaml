<Window x:Class="NetSentry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:NetSentry.App.Views"
        mc:Ignorable="d"
        Title="FreeFing - Advanced Network Monitor &amp; Guard"
        Width="1320" Height="860"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#0E131F"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid Background="#0E131F">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════
             LEFT NAVIGATION RAIL
             ══════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#121824" BorderBrush="#1C2436" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <!-- Top Primary Brand Glyph -->
                <TextBlock DockPanel.Dock="Top" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" 
                           Foreground="#2563EB" FontSize="22" HorizontalAlignment="Center" Margin="0,18,0,24"/>

                <!-- Navigation Tabs: Overview, Devices (Computer Icon), Security -->
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <!-- Tab 1: Overview -->
                    <Button x:Name="NavOverviewBtn" Style="{StaticResource NavIconButtonStyle}" 
                            Content="&#xE80F;" ToolTip="Overview" Click="NavOverview_Click" Margin="0,0,0,12"/>

                    <!-- Tab 2: Devices (Computer Icon &#xE7F5;) -->
                    <Button x:Name="NavDevicesBtn" Style="{StaticResource NavIconButtonStyle}" 
                            Content="&#xE7F5;" ToolTip="Device Inventory" Click="NavDevices_Click" Margin="0,0,0,12"/>

                    <!-- Tab 3: Security -->
                    <Button x:Name="NavSecurityBtn" Style="{StaticResource NavIconButtonStyle}" 
                            Content="&#xEBE8;" ToolTip="Security &amp; Defense" Click="NavSecurity_Click" Margin="0,0,0,12"/>
                </StackPanel>

                <!-- Settings Tab -->
                <Button x:Name="NavSettingsBtn" DockPanel.Dock="Bottom" Style="{StaticResource NavIconButtonStyle}" 
                        Content="&#xE713;" ToolTip="System Settings" Click="NavSettings_Click" Margin="0,0,0,18"/>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════
             MAIN VIEWPORT CANVAS
             ══════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Global Top Application Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Page Content Viewport -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Global Top Application Bar ── -->
            <Border Grid.Row="0" Background="#121824" BorderBrush="#1C2436" BorderThickness="0,0,0,1" Padding="28,14,28,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Breadcrumb & Network Status -->
                        <ColumnDefinition Width="*" />
                        <!-- Top Nav Tab Switcher -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Quick Scan Action -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Network Title & Connection Subtitle -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="FreeFing Desktop" FontSize="16" FontWeight="Bold" Foreground="White" />
                            <Border Background="#1A2563EB" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Text="v2.4 Enterprise" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TopSubnetBlock" Text="Connected to Home Subnet • 192.168.1.0/24" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- Top Navigation Tabs (Overview, Devices, Security, Settings) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Button x:Name="TopTabOverview" Content="Overview" Click="NavOverview_Click"
                                Style="{StaticResource TopNavButtonStyle}" Margin="0,0,6,0" Padding="14,6" />
                        <Button x:Name="TopTabDevices" Content="Devices" Click="NavDevices_Click"
                                Style="{StaticResource TopNavButtonStyle}" Margin="0,0,6,0" Padding="14,6" />
                        <Button x:Name="TopTabSecurity" Content="Security" Click="NavSecurity_Click"
                                Style="{StaticResource TopNavButtonStyle}" Margin="0,0,6,0" Padding="14,6" />
                        <Button x:Name="TopTabSettings" Content="Settings" Click="NavSettings_Click"
                                Style="{StaticResource TopNavButtonStyle}" Padding="14,6" />
                    </StackPanel>

                    <!-- Scan Trigger Button -->
                    <Button Grid.Column="2" x:Name="GlobalScanBtn" Content="Scan Network" 
                            Style="{StaticResource ScanButtonStyle}"
                            Padding="18,7"
                            Click="GlobalScanBtn_Click"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Page Content Multi-View Container ── -->
            <Grid Grid.Row="1">
                <!-- Page 1: Overview View (Total Devices, Net Traffic Amount, Scan, ISP with dynamic logo) -->
                <views:OverviewView x:Name="OverviewControl" Visibility="Visible" />

                <!-- Page 2: Device List View (All devices with type, brand, status filtering, prominent model) -->
                <views:DeviceListView x:Name="DeviceListControl" Visibility="Collapsed" />

                <!-- Page 3: Device Detail View (Full device specifications, model identification, open ports, block) -->
                <views:DeviceDetailView x:Name="DeviceDetailControl" Visibility="Collapsed" />

                <!-- Page 4: Security View (Firewall status, isolated devices list with unblock controls) -->
                <views:SecurityView x:Name="SecurityControl" Visibility="Collapsed" />

                <!-- Page 5: Settings View (Adapter bindings, scan frequencies, database diagnostics) -->
                <views:SettingsView x:Name="SettingsControl" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>

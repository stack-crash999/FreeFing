<Window x:Class="NetSentry.App.Views.EditNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Device Name" Height="170" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0B101D" Foreground="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Enter new name for this device:" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,10" />

        <TextBox Grid.Row="1" x:Name="NameInput" Height="32" Padding="8,4"
                 Background="#131B2E" Foreground="#F8FAFC"
                 BorderBrush="#1E2942" BorderThickness="1" FontSize="13" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource TopNavButtonStyle}" Margin="0,0,8,0" Width="80" />
            <Button Content="Save" IsDefault="True" Click="Save_Click" Style="{StaticResource TopNavButtonStyle}" Width="80"
                    Background="{StaticResource AccentBlueBrush}" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>

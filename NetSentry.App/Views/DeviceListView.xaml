<UserControl x:Class="NetSentry.App.Views.DeviceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:NetSentry.App.Models"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="#0E131F">

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <!-- Header Title & Subtitle -->
            <RowDefinition Height="Auto" />
            <!-- Search & Filters Strip -->
            <RowDefinition Height="Auto" />
            <!-- Device Fleet Table / List -->
            <RowDefinition Height="*" />
            <!-- Pagination / Telemetry Bottom Strip -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════
             ROW 0: HEADER TITLE & TOTAL COUNT
             ══════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TitleBlock" Text="Device Inventory"
                           FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                <TextBlock x:Name="SubtitleBlock" Text="Showing active subnet devices • Click any host to inspect full hardware specs"
                           FontSize="13" Foreground="#94A3B8" />
            </StackPanel>

            <!-- Protection Active Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1A10B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="ARP Guard Active" FontSize="11.5" FontWeight="SemiBold" Foreground="#10B981" />
                    </StackPanel>
                </Border>
                <Border Background="#121824" BorderBrush="#232E45" BorderThickness="1" CornerRadius="6" Padding="10,4">
                    <TextBlock x:Name="UpdatedBlock" Text="Updated Just now" FontSize="11.5" Foreground="#94A3B8" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════
             ROW 1: SEARCH & FILTER CONTROLS (TYPE, BRAND, STATUS)
             ══════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- Search Box -->
                <ColumnDefinition Width="320" />
                <!-- Filter Dropdowns -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Search input with vector icon -->
            <Border Grid.Column="0" Background="#121824" BorderBrush="#232E45" BorderThickness="1" CornerRadius="8" Height="36" Padding="10,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="#64748B"
                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <TextBox Grid.Column="1" x:Name="SearchBox"
                             Background="Transparent" BorderThickness="0"
                             Foreground="White" CaretBrush="#2563EB"
                             FontFamily="Consolas, Cascadia Code" FontSize="12.5" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" Text="Filter by name, model, vendor, IP..."
                               Foreground="#64748B" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Filter Dropdowns (Type, Brand, Status) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Device Type Filter -->
                <TextBlock Text="Type:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="TypeFilterCombo" SelectedIndex="0" Width="130" Height="34" Margin="0,0,14,0">
                    <ComboBoxItem Content="All Types" />
                    <ComboBoxItem Content="Workstation" />
                    <ComboBoxItem Content="Laptop" />
                    <ComboBoxItem Content="Mobile" />
                    <ComboBoxItem Content="Television" />
                    <ComboBoxItem Content="Printer" />
                    <ComboBoxItem Content="Router" />
                    <ComboBoxItem Content="Smart Device" />
                    <ComboBoxItem Content="Generic" />
                </ComboBox>

                <!-- Brand / Vendor Filter -->
                <TextBlock Text="Brand:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="BrandFilterCombo" SelectedIndex="0" Width="140" Height="34" Margin="0,0,14,0">
                    <ComboBoxItem Content="All Brands" />
                </ComboBox>

                <!-- Status Filter -->
                <TextBlock Text="Status:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="StatusFilterCombo" SelectedIndex="0" Width="110" Height="34">
                    <ComboBoxItem Content="All Status" />
                    <ComboBoxItem Content="Online" />
                    <ComboBoxItem Content="Blocked" />
                    <ComboBoxItem Content="Offline" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════
             ROW 2: DEVICE FLEET LIST (CLICKABLE FOR FULL DETAILS)
             ══════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#182030" BorderBrush="#232E45" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <ListView x:Name="DeviceListViewControl"
                      Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionMode="Single"
                      SelectionChanged="DeviceListView_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#1C2538" />
                        <Setter Property="Padding" Value="18,14" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="rowBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="rowBorder" Property="Background" Value="#1E283C" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="rowBorder" Property="Background" Value="#22304A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:DeviceItem}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <!-- Col 0: Device Icon Badge -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Col 1: Identity & Model Display -->
                                <ColumnDefinition Width="*" />
                                <!-- Col 2: Vendor Tag -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Col 3: Status Badge -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Col 4: Action Button -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Col 5: Arrow Navigate Caret -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: Device Icon Badge -->
                            <Border Grid.Column="0" Background="#121824" Width="44" Height="44" CornerRadius="10" Margin="0,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" Foreground="#94A3B8" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Col 1: Friendly Name, Device Model, IP & MAC -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <!-- Friendly Name -->
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    
                                    <!-- Device Model prominently displayed -->
                                    <Border Background="#1C2538" BorderBrush="#28354E" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Model, StringFormat='Model: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                    </Border>
                                </StackPanel>

                                <!-- Subline: IP Address • MAC Address -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Ip}" FontSize="12" Foreground="#94A3B8" FontFamily="Consolas, Cascadia Code"/>
                                    <TextBlock Text=" • " Foreground="#64748B"/>
                                    <TextBlock Text="{Binding MacUpper}" FontSize="12" Foreground="#64748B" FontFamily="Consolas, Cascadia Code"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Col 2: Vendor Tag -->
                            <Border Grid.Column="2" Background="#121824" BorderBrush="#232E45" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Vendor}" FontSize="11" Foreground="#CBD5E1"/>
                            </Border>

                            <!-- Col 3: Status Badge -->
                            <Border Grid.Column="3" Background="{Binding StatusBackgroundBrush}" CornerRadius="12" Padding="12,4" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusForegroundBrush}"/>
                            </Border>

                            <!-- Col 4: Action Button (Block / Unblock) -->
                            <Button Grid.Column="4" Content="{Binding ActionButtonText}" 
                                    Background="{Binding ActionBackgroundBrush}" 
                                    Foreground="{Binding ActionForegroundBrush}"
                                    Style="{StaticResource RowActionButtonStyle}"
                                    Click="ActionButton_Click"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"/>

                            <!-- Col 5: Arrow Caret -->
                            <TextBlock Grid.Column="5" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- ══════════════════════════════════════════════
             ROW 3: BOTTOM TELEMETRY STRIP
             ══════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="PaginationBlock" Text="Showing 0 active devices on subnet"
                       Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />

            <TextBlock Grid.Column="1" Text="Click any device to view hardware specs, model information, and open ports"
                       Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>

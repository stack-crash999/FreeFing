<UserControl x:Class="NetSentry.App.Views.DeviceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:NetSentry.App.Models"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="950"
             Background="{StaticResource BgWindowBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Row 0: Back Navigation Button ── -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <Button x:Name="BackToDevicesBtn" Click="BackToDevices_Click"
                        Style="{StaticResource TopNavButtonStyle}" HorizontalAlignment="Left" Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBack}" Fill="{StaticResource AccentCyanBrush}"
                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Back to Device Inventory" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ── Row 1: Top Header Row (Name & Action Buttons) ── -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="DeviceNameBlock" Text="Device Hostname"
                           FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Rename Device" Style="{StaticResource TopNavButtonStyle}" Margin="0,0,8,0" Click="EditName_Click" />
                    <Button x:Name="RevertBtn" Content="Reset Name" Style="{StaticResource TopNavButtonStyle}" Click="Revert_Click" />
                </StackPanel>
            </Grid>

            <!-- ── Row 2: Subtitle Metadata Badges (No fake dropdowns, no emojis) ── -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,22">
                <Border Style="{StaticResource PillNeutralStyle}" Margin="0,0,8,0">
                    <TextBlock x:Name="TypePillBlock" Text="Device" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                </Border>

                <Border Style="{StaticResource PillNeutralStyle}" Margin="0,0,8,0">
                    <TextBlock x:Name="ModelPillBlock" Text="Hardware Model" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </Border>

                <Border Style="{StaticResource PillNeutralStyle}" Margin="0,0,8,0">
                    <TextBlock x:Name="OsPillBlock" Text="Operating System" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </Border>

                <Border x:Name="StatusPillBorder" Style="{StaticResource PillGreenStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusPillDot" Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusPillBlock" Text="Online" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#34D399" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── Row 3: Clean Two-Column Body Layout ── -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <!-- ════════ LEFT COLUMN: NETWORK & HARDWARE SPECS ════════ -->
                <StackPanel Grid.Column="0">
                    <!-- Network & Hardware Specification Card -->
                    <Border Style="{StaticResource FingCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="NETWORK &amp; HARDWARE CONFIGURATION" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

                            <!-- IP Address with Inline Copy -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="IP Address" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="IpValBlock" Text="192.168.68.1"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="Copy IP" Style="{StaticResource TopNavButtonStyle}"
                                        Padding="10,3" FontSize="11" Click="CopyIp_Click" />
                            </Grid>

                            <!-- MAC Address with Inline Copy -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="MAC Address" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="MacValBlock" Text="00:00:00:00:00:00"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas, Cascadia Code, Courier New"
                                           FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="Copy MAC" Style="{StaticResource TopNavButtonStyle}"
                                        Padding="10,3" FontSize="11" Click="CopyMac_Click" />
                            </Grid>

                            <!-- Vendor / Manufacturer -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Vendor / OUI" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="BrandValBlock" Text="Unknown"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Width="30" Height="30" CornerRadius="6" Background="#172554">
                                    <TextBlock x:Name="BrandAvatarBlock" Text="DV" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- Hardware Model -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Model" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="ModelValBlock" Text="Generic Host"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Operating System -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Platform OS" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="OsValBlock" Text="Embedded / Windows"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Detection Times -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Audit Status" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="AuditStatusBlock" Text="Verified active on local subnet"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ════════ RIGHT COLUMN: SECURITY & ISOLATION ════════ -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource FingCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconShield}" Fill="{StaticResource AccentCyanBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="NETWORK DEFENSE &amp; ISOLATION" FontSize="11.5" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Real-time Status Card -->
                            <Border Background="#0C1322" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="FIREWALL STATUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock x:Name="IsolationStatusBlock" Text="Unrestricted Access"
                                               FontSize="15" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,4" />
                                    <TextBlock Text="Host has standard bidirectional gateway routing on the local subnet."
                                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Security Explanation -->
                            <TextBlock Text="ARP Spoofing Isolation:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Blocking this device instructs NetSentry to redirect its ARP requests, severing all gateway and internet connectivity immediately."
                                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,18" LineHeight="17" />

                            <!-- Primary Action Block Button -->
                            <Button x:Name="BlockButton" Click="BlockButton_Click" Height="42" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" CornerRadius="8" Padding="14,0"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Background" Value="#EF4444" />
                                        <Setter Property="BorderBrush" Value="#DC2626" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

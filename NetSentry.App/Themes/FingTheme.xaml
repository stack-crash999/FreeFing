    <!-- ══════════════════════════════════════════════
         GLASS CARD STYLE (COMMAND DECK)
         ══════════════════════════════════════════════ -->
    <Style x:Key="StyleGlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushGlassSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushGlassBorderGradient}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" Color="#000000" Opacity="0.45" Direction="270" ShadowDepth="3"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FingCardStyle" TargetType="Border" BasedOn="{StaticResource StyleGlassCard}"/>

    <!-- ══════════════════════════════════════════════
         BREATHING STATUS HEARTBEAT DOT
         ══════════════════════════════════════════════ -->
    <Style x:Key="StyleStatusDotPulse" TargetType="Ellipse">
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="1.0" To="0.45" Duration="0:0:1.2">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         From="1.0" To="1.25" Duration="0:0:1.2"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         From="1.0" To="1.25" Duration="0:0:1.2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════
         NAVIGATION RAIL BUTTON STYLE
         ══════════════════════════════════════════════ -->
    <Style x:Key="StyleNavRailButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="ActivePill" Width="3.5" Height="24" HorizontalAlignment="Left"
                                Background="{StaticResource BrushElectricCyan}" CornerRadius="1.5"
                                Visibility="Collapsed" />
                        <Border x:Name="HoverSurface" CornerRadius="8" Background="Transparent" Margin="6,3">
                            <Path x:Name="IconPath" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="{StaticResource BrushTextMuted}" Width="19" Height="19" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverSurface" Property="Background" Value="#1C2333" />
                            <Setter TargetName="IconPath" Property="Fill" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ActivePill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverSurface" Property="Background" Value="#132438" />
                            <Setter TargetName="IconPath" Property="Fill" Value="{StaticResource BrushElectricCyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource StyleNavRailButton}"/>

    <!-- ══════════════════════════════════════════════
         CATEGORY FILTER PILL STYLE
         ══════════════════════════════════════════════ -->
    <Style x:Key="StyleCategoryFilterPill" TargetType="RadioButton">
        <Setter Property="Background" Value="#141824" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGlass}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="PillBorder" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PillBorder" Property="Background" Value="#1E2333" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PillBorder" Property="Background" Value="#102538" />
                            <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource BrushElectricCyan}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushElectricCyan}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════
         TOP ACTION & SCAN BUTTON STYLES
         ══════════════════════════════════════════════ -->
    <Style x:Key="TopNavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BgSurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderMediumBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#0F1420" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScanNetworkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#102538" />
        <Setter Property="Foreground" Value="{StaticResource BrushElectricCyan}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushElectricCyan}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#173550" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#0B1A28" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill Styles -->
    <Style x:Key="PillNeutralStyle" TargetType="Border">
        <Setter Property="Background" Value="#141824" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderGlass}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Height" Value="24" />
    </Style>

    <Style x:Key="PillGreenStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StatusGreenBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusGreenBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- Slim Modern ScrollBar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#2B374E" CornerRadius="3" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

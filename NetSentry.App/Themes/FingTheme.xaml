<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════
         FING DESKTOP NAVY & BLUE COLOR PALETTE
         ══════════════════════════════════════════════ -->
    <Color x:Key="ColorCanvas">#0E131F</Color>
    <Color x:Key="ColorNavRail">#121824</Color>
    <Color x:Key="ColorCard">#182030</Color>
    <Color x:Key="ColorCardElevated">#202A3E</Color>
    <Color x:Key="ColorBorder">#232E45</Color>
    <Color x:Key="ColorBrandBlue">#2563EB</Color>
    <Color x:Key="ColorStatusGreen">#10B981</Color>
    <Color x:Key="ColorStatusRed">#F43F5E</Color>
    <Color x:Key="ColorStatusBlue">#3B82F6</Color>
    <Color x:Key="ColorTextPrimary">#FFFFFF</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>

    <SolidColorBrush x:Key="BrushCanvas" Color="{StaticResource ColorCanvas}" />
    <SolidColorBrush x:Key="BrushNavRail" Color="{StaticResource ColorNavRail}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BrushCardElevated" Color="{StaticResource ColorCardElevated}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBrandBlue" Color="{StaticResource ColorBrandBlue}" />

    <!-- Aliases for views -->
    <SolidColorBrush x:Key="BgWindowBrush" Color="{StaticResource ColorCanvas}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource ColorNavRail}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BgCardInnerBrush" Color="{StaticResource ColorCardElevated}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BgSurfaceHoverBrush" Color="#222C3D" />
    <SolidColorBrush x:Key="BgInputBrush" Color="#121622" />

    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource ColorBrandBlue}" />
    <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentBluePressedBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BorderMediumBrush" Color="#334155" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

    <SolidColorBrush x:Key="StatusGreenBg" Color="#1A10B981" />
    <SolidColorBrush x:Key="StatusGreenFg" Color="#10B981" />
    <SolidColorBrush x:Key="StatusGreenBorder" Color="#10B981" />

    <SolidColorBrush x:Key="StatusRedBg" Color="#1AF43F5E" />
    <SolidColorBrush x:Key="StatusRedFg" Color="#F43F5E" />
    <SolidColorBrush x:Key="StatusRedBorder" Color="#F43F5E" />

